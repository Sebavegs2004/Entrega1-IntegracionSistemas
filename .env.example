# Variables de entorno para levantar VidaAnimal
# Copia este archivo a .env y ajusta los valores antes de levantar:
#   cp .env.example .env

# Clave para escritura (POST /v1/duenos, POST /v1/reservas, DELETE /v1/reservas/{id})
API_KEY=tu-clave-de-escritura-aqui

# Clave para lectura (GET /v1/*)
API_KEY_LECTURA=tu-clave-de-lectura-aqui
