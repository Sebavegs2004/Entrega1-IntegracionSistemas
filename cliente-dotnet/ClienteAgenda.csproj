<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClienteAgenda</RootNamespace>
    <!-- Los artefactos bin/ y obj/ se ignoran con .gitignore -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Net.Client" Version="2.66.0" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Grpc.Tools compila contracts/agenda.proto a C# AUTOMATICAMENTE
       en cada "dotnet build" (a diferencia de Python, no hay protoc manual).
       GrpcServices="Client" genera solo el cliente, no el servidor.
       package "agenda.v1" del .proto -> espacio de nombres C# "Agenda.V1". -->
  <ItemGroup>
    <Protobuf Include="..\contracts\agenda.proto"
              GrpcServices="Client"
              Link="Protos\agenda.proto" />
  </ItemGroup>

</Project>